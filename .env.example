# ===========================================
# Configuration HERA V2
# Copier ce fichier vers .env et adapter les valeurs
# ===========================================

# ============ Base de données ============
POSTGRES_USER=hera
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=hera_db
POSTGRES_PORT=5432

# ============ API Backend ============
SECRET_KEY=change-me-with-a-secure-random-key-in-production
DEBUG=true
ENVIRONMENT=development
API_PORT=8000

# ============ Authentification ============
# Options: local, saml, oidc
AUTH_PROVIDER=local

# ============ SAML (Renater/Shibboleth) ============
# Décommenter et configurer si AUTH_PROVIDER=saml
# SAML_ENABLED=true
# SAML_METADATA_URL=https://federation.renater.fr/...
# SAML_ENTITY_ID=https://hera.votre-etablissement.fr
# SAML_ACS_URL=https://hera.votre-etablissement.fr/api/v1/auth/saml/callback
# SAML_SLS_URL=https://hera.votre-etablissement.fr/api/v1/auth/saml/logout

# ============ OIDC ============
# Décommenter et configurer si AUTH_PROVIDER=oidc
# OIDC_ENABLED=true
# OIDC_PROVIDER_URL=https://auth.votre-etablissement.fr
# OIDC_CLIENT_ID=hera-client
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://hera.votre-etablissement.fr/api/v1/auth/oidc/callback

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ pgAdmin (optionnel) ============
PGADMIN_EMAIL=admin@hera.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
